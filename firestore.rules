rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // players/{uid}
    // Public read so admin panel and scoring app can see all players.
    // Admin panel has full CRUD (client-side passcode gate).
    // Players create their own PIN on first login.
    match /players/{uid} {
      allow read, write: if true;
    }

    // scores/{scoreId}
    // Public read for the live leaderboard.
    // PIN-based auth - validation is done client-side.
    // Admin panel can create/update/delete any score (client-side passcode gate).
    match /scores/{scoreId} {
      allow read: if true;

      // Players can create/update their own scores (PIN validation is client-side)
      allow create, update: if request.resource.data.uid is string
        && request.resource.data.year is int
        && request.resource.data.dayNumber is int
        && request.resource.data.dayNumber >= 1
        && request.resource.data.dayNumber <= 7
        && request.resource.data.holes is list
        && request.resource.data.holes.size() == 18;

      // Admin panel can delete any score
      allow delete: if true;
    }

    // courses/{courseId}
    // Par and difficulty config set by admin panel.
    match /courses/{courseId} {
      allow read, write: if true;
    }

    // formats/{formatId}
    // Game format definitions set by admin panel.
    match /formats/{formatId} {
      allow read, write: if true;
    }

    // days/{dayId}
    // Daily configuration (course + format assignments) set by admin panel.
    match /days/{dayId} {
      allow read, write: if true;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
